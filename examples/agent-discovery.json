  "transport": "mcp_stdio",
  "public_execution_endpoint": null,
  "capabilities": [
    {
      "id": "provider_discovery",
      "tools": [
        "discover_providers",
        "discover_agents",
        "match_task"
      ],
      "mode": "brokerage_delegation",
      "purpose": "Find reviewed providers for supported capabilities.",
      "external_execution": false
    },
    {
      "id": "doi_metadata",
      "tools": [
        "route_task",
        "execute_route",
        "track_referral"
