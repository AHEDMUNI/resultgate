    {
      "id": "provider_submission",
      "tools": [
        "submit_provider",
        "update_provider",
        "suspend_provider",
        "discover_registered_providers"
      ],
      "mode": "local_registry",
      "purpose": "Submit public service metadata for separate ownership and operator review.",
      "external_execution": false,
      "automatic_approval": false,
      "submitted_provider_execution": false
    }
  ],
  "unsupported_capabilities": [],
