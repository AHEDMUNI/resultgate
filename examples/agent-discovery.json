{
  "format": "resultgate-capability-catalog-v1",
  "standard": false,
  "a2a_supported": false,
  "server_name": "io.github.AHEDMUNI/resultgate",
  "published_package": {
    "name": "resultgate-pilot",
    "version": "0.3.0"
  },
