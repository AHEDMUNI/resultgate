      "tools": [
        "prepare_delegation",
        "execute_delegation",
        "delegation_status"
      ],
      "mode": "brokerage_delegation",
      "purpose": "Structure a public citation using the reviewed GROBID demo.",
      "external_execution": true,
      "required_operator_flag": "--allow-demo-task-requests",
      "per_call_consent": "consent_to_send_public_citation",
      "provider_kind": "specialist_ml_demo",
      "verification_scope": "predeclared surname and year, not full semantic correctness"
    },
    {
      "id": "result_validation",
      "tools": [
        "check_extraction",
        "check_citations"
      ],
      "mode": "default",
      "purpose": "Check supplied extraction contracts and literal citation integrity.",
      "external_execution": false,
      "verification_scope": "caller-supplied evidence only"
