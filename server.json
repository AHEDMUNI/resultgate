{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.AHEDMUNI/resultgate",
  "title": "ResultGate",
  "description": "Local service recommendations for six providers, disclosed referrals and evidence checks.",
  "version": "0.3.0",
  "repository": {
    "url": "https://github.com/AHEDMUNI/resultgate",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "resultgate-pilot",
      "version": "0.3.0",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "--referrals"
        }
      ]
    }
  ]
}
